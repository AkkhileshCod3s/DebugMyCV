# ── CareerLens AI — environment configuration ────────────────────────────────
# Copy to `.env` (repository root) and fill in the values you must provide.
# NEVER commit the real `.env` file.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── MySQL database (REQUIRED — provide your own credentials) ─────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=careerlens_ai
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# ── Sessions (REQUIRED in production: at least 32 random characters) ─────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret

# ── Groq AI (REQUIRED for analysis; leave empty to disable AI features) ──────
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Quotas & limits ──────────────────────────────────────────────────────────
# Successful resume uploads allowed per user per Asia/Kolkata calendar day.
MAX_RESUME_UPLOADS_PER_DAY=5
# Successful AI analyses allowed per user per Asia/Kolkata calendar day.
# Conservative default (10) so development/testing stays inside free-tier limits.
MAX_ANALYSES_PER_DAY=10
MAX_RESUME_FILE_SIZE_MB=5
# Max characters accepted for resume text / job description text.
MAX_INPUT_CHARACTERS=20000
# Max tokens requested from the Groq model per analysis.
MAX_OUTPUT_TOKENS=2500

# ── AI & locale ──────────────────────────────────────────────────────────────
AI_ENABLED=true
APP_TIMEZONE=Asia/Kolkata
