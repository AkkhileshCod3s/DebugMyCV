# ── DebugMyCV — environment configuration ────────────────────────────────
# Copy to `server/.env` (the server loads .env from the server/ directory).
# NEVER commit the real `.env` file.

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://debugmycv.com
CLIENT_PORT=5173

# ── Supabase / Postgres (REQUIRED) ────────────────────────────────────────
# Supabase pooled connection string, e.g.:
# postgres://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/careerlens_ai
DATABASE_URL=
DB_POOL_SIZE=3

# ── Sessions & auth (REQUIRED in production) ──────────────────────────────
# SESSION_SECRET: 32+ random characters
# JWT_SECRET: optional, if you add token-based auth later
SESSION_SECRET=
JWT_SECRET=

# ── Groq AI (REQUIRED for analysis) ───────────────────────────────────────
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Quotas & limits ───────────────────────────────────────────────────────
# Successful resume uploads allowed per user per Asia/Kolkata calendar day.
MAX_RESUME_UPLOADS_PER_DAY=5
# Successful AI analyses allowed per user per Asia/Kolkata calendar day.
MAX_ANALYSES_PER_DAY=10
# Max resume file size in MB (Vercel request body limit is ~4.5 MB).
MAX_RESUME_FILE_SIZE_MB=4
# Max characters accepted for resume text / job description text.
MAX_INPUT_CHARACTERS=20000
# Max tokens requested from the Groq model per analysis.
MAX_OUTPUT_TOKENS=2500

# ── AI & locale ───────────────────────────────────────────────────────────
AI_ENABLED=true
APP_TIMEZONE=Asia/Kolkata
